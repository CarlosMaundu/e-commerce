# Copy to backend/.env (gitignored). Used by docker-compose for the api service.

# Long random value, e.g. `openssl rand -base64 48`. Required in production.
JWT_SECRET=

# First super admin, created on startup only if none exists yet.
# Password: at least 12 characters. Change it after first sign-in.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Google Identity Services OAuth client ID (same value as the frontend's
# REACT_APP_GOOGLE_CLIENT_ID). Empty disables Google sign-in.
GOOGLE_CLIENT_ID=

# Real SMTP for production. In Docker, mail goes to Mailpit by default.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
# MAIL_FROM=Carlos Shop <no-reply@example.com>

# Card payments (optional). Without these, checkout offers cash on delivery only.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...

# Shop settings
# Defaults for Back office → Financial settings (saved settings win):
# CURRENCY=KES
# TAX_LABEL=VAT
# TAX_RATE=0.16
# PRICES_INCLUDE_TAX=true
# STANDARD_SHIPPING=300
# EXPRESS_SHIPPING=650
# FREE_SHIPPING_OVER=10000
