# Copy to backend/.env (gitignored). Used by docker-compose for the api service.

# Long random value, e.g. `openssl rand -base64 48`. Required in production.
JWT_SECRET=

# First super admin, created on startup only if none exists yet.
# Password: at least 12 characters. Change it after first sign-in.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Google Identity Services OAuth client ID (same value as the frontend's
# REACT_APP_GOOGLE_CLIENT_ID). Empty disables Google sign-in.
GOOGLE_CLIENT_ID=

# Real SMTP for production. In Docker, mail goes to Mailpit by default.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
# MAIL_FROM=Carlos Shop <no-reply@example.com>

# Encrypts payment credentials saved under Back office → Payment methods.
# Defaults to JWT_SECRET; if the key changes, enter the credentials again.
# PAYMENTS_SECRET_KEY=

# Card payments (optional). Without these, checkout offers cash on delivery only.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...

# The shop's time zone (IANA name): what "today" and report days mean.
# SHOP_TIMEZONE=Africa/Nairobi

# Shop settings
# Defaults for Back office → Financial settings (saved settings win):
# CURRENCY=KES
# TAX_LABEL=VAT
# TAX_RATE=0.16
# PRICES_INCLUDE_TAX=true
# STANDARD_SHIPPING=300
# EXPRESS_SHIPPING=650
# FREE_SHIPPING_OVER=10000

# Operations
# Error tracking: unexpected API errors go to Sentry when set.
# SENTRY_DSN=
# One JSON log line per request (set false to turn off).
# LOG_REQUESTS=true
# Key for the anonymous daily visitor code (searches, deal views).
# Defaults to one derived from JWT_SECRET.
# VISITOR_HASH_SECRET=
# Stripe webhook signing secret (or set it under Payment methods → Card).
# STRIPE_WEBHOOK_SECRET=

# Image storage: S3-compatible object storage (AWS S3, Cloudflare R2, MinIO).
# Unset = the uploads folder on this server.
# S3_BUCKET=
# S3_PUBLIC_URL=https://images.example.com
# S3_REGION=auto
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
