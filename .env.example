# Frontend settings. Copy to .env and restart `npm start`.
# Backend settings live in backend/.env (see backend/.env.example).

# API base URL. Leave empty to use /api on the same origin (the dev server
# proxies it to localhost:4000; nginx proxies it in Docker).
REACT_APP_API_BASE_URL=

# Google Identity Services OAuth client ID (Google Cloud console > APIs &
# Services > Credentials). Authorized JavaScript origins must include
# http://localhost:3000 and http://localhost:8080. Empty hides Google sign-in.
REACT_APP_GOOGLE_CLIENT_ID=

# Stripe keys now live in backend/.env (STRIPE_SECRET_KEY,
# STRIPE_PUBLISHABLE_KEY); the publishable key reaches the browser via the API.

# Error tracking: browser crashes go to Sentry when set (baked in at build).
REACT_APP_SENTRY_DSN=

# Backup monitor: the nightly backup checks in with Sentry when set.
# Built from the API project's DSN (https://KEY@HOST/PROJECT_ID):
#   https://HOST/api/PROJECT_ID/cron/nightly-db-backup/KEY/
SENTRY_CRON_URL=
