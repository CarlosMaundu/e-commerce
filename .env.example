# Frontend settings. Copy to .env and restart `npm start`.
# Backend settings live in backend/.env (see backend/.env.example).

# API base URL. Leave empty to use /api on the same origin (the dev server
# proxies it to localhost:4000; nginx proxies it in Docker).
REACT_APP_API_BASE_URL=

# Google Identity Services OAuth client ID (Google Cloud console > APIs &
# Services > Credentials). Authorized JavaScript origins must include
# http://localhost:3000 and http://localhost:8080. Empty hides Google sign-in.
REACT_APP_GOOGLE_CLIENT_ID=

# Stripe (payments are deferred until the backend handles them)
REACT_APP_STRIPE_PUBLISHABLE_KEY=
REACT_APP_STRIPE_SECRET_KEY=
