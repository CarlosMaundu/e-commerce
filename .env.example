# Copy to .env and fill in, then restart `npm start`.

# Where data comes from: demo (public demo API), mock (in-browser fake
# backend implementing src/api/contract.md) or api (our backend).
REACT_APP_DATA_SOURCE=demo
# Our backend's base URL; only used when REACT_APP_DATA_SOURCE=api.
REACT_APP_API_BASE_URL=
# Firebase: Firebase console > Project settings > General > Your apps > SDK config
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_MEASUREMENT_ID=

# Stripe
REACT_APP_STRIPE_PUBLISHABLE_KEY=
REACT_APP_STRIPE_SECRET_KEY=
